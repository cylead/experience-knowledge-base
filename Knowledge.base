filters:
  not:
    - 'file.inFolder("System/Templates")'
properties:
  file.name:
    displayName: Note
  source_kind:
    displayName: Source kind
  creator:
    displayName: Creator
  source_date:
    displayName: Source date
  engagement_status:
    displayName: Engagement status
  maturity:
    displayName: Maturity
  aliases:
    displayName: Aliases
  related_concepts:
    displayName: Related concepts
  origin:
    displayName: Origin
  status:
    displayName: Status
  practice_kind:
    displayName: Practice kind
  cadence:
    displayName: Cadence
  next_review:
    displayName: Next review
  updated:
    displayName: Updated
views:
  - type: table
    name: "Source library"
    filters:
      and:
        - 'type == "source"'
    order:
      - file.name
      - source_kind
      - creator
      - engagement_status
      - source_date
      - updated
  - type: table
    name: "Developing insights"
    filters:
      and:
        - 'type == "insight"'
        - 'maturity != "evergreen"'
    order:
      - file.name
      - maturity
      - sources
      - concepts
      - origin
      - updated
  - type: table
    name: "Concept index"
    filters:
      and:
        - 'type == "concept"'
    order:
      - file.name
      - aliases
      - related_concepts
      - updated
  - type: table
    name: "Proposed practices"
    filters:
      and:
        - 'type == "practice"'
        - 'status == "proposed"'
    order:
      - file.name
      - practice_kind
      - derived_from
      - concepts
      - origin
      - cadence
      - updated
  - type: table
    name: "Active practices due"
    filters:
      and:
        - 'type == "practice"'
        - 'status == "active"'
        - 'next_review <= today()'
    order:
      - file.name
      - practice_kind
      - next_review
      - cadence
      - derived_from
      - updated
